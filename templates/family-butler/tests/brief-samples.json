          { "id": "ev3", "title": "Skating", "start_time": "16:00", "end_time": "17:30", "who": "Agastya", "location": null,
            "notes": "Lakshmi drops", "kind": "event", "status": "active", "sources": [], "added_by": "Shiva",
            "todos": { "open": 1, "titles": ["Carry skates"] } }
        ],
        "changed": [],
        "new": [],
        "todos_due": [
          { "title": "Pay the school fee", "due": "2026-11-23", "event": "School fee due" },
          { "title": "Sign the trip form", "due": "2026-11-26", "event": "School trip" }
