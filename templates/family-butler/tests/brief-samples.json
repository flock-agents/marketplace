        "events": [
          { "id": "ev1", "title": "Unit test", "start_time": null, "end_time": null, "who": "Meera", "location": null,
            "notes": null, "kind": "event", "status": "active", "sources": ["MyClassBoard"], "added_by": null,
            "todos": { "open": 0, "titles": [] } },
          { "id": "ev2", "title": "School fee due", "start_time": null, "end_time": null, "who": "Agastya", "location": null,
