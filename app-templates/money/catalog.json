{
  "name": "money",
  "version": 1,
  "description": "A household's money (not a business's books): transactions, budgets, investments and goals.",
  "objects": [
    "receipt"
  ],
  "labels": {
    "nav.overview": "Overview",
    "nav.transactions": "Transactions",
    "nav.budgets": "Budgets",
    "nav.investments": "Investments",
    "nav.goals": "Goals",
    "title.overview": "Overview",
    "title.transactions": "Transactions",
    "title.budgets": "Budgets",
    "title.investments": "Investments",
    "title.goals": "Goals"
  },
  "tables": {
    "transactions": {
      "note": "Every money, transaction and holding amount is whole rupees. A negative transaction amount is money spent.",
      "columns": {
        "date": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "ISO date"
        },
        "merchant": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "category": {
          "type": "string",
          "required": true,
          "nullable": false,
          "enum": [
            "Salary",
            "Freelance",
            "Interest & dividends",
            "Other income",
            "Rent",
            "Groceries",
            "Eating out",
            "Travel",
            "Utilities",
            "Shopping",
            "Investments"
          ]
        },
        "amount": {
          "type": "integer",
          "required": true,
          "nullable": false,
          "note": "negative = spend"
        }
      }
    },
    "budgets": {
      "note": "One spending limit per category per month. How much was spent is worked out from the transactions.",
      "columns": {
        "category": {
          "type": "string",
          "required": true,
          "nullable": false,
          "enum": [
            "Salary",
            "Freelance",
            "Interest & dividends",
            "Other income",
            "Rent",
            "Groceries",
            "Eating out",
            "Travel",
            "Utilities",
            "Shopping",
            "Investments"
          ]
        },
        "month": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "YYYY-MM"
        },
        "limit_amount": {
          "type": "integer",
          "required": true,
          "nullable": false
        }
      }
    },
    "holdings": {
      "columns": {
        "name": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "kind": {
          "type": "string",
          "required": true,
          "nullable": false,
          "enum": [
            "Equity funds",
            "Index funds",
            "Stocks",
            "Fixed deposits",
            "Gold",
            "PPF"
          ]
        },
        "value": {
          "type": "integer",
          "required": true,
          "nullable": false,
          "note": "worth today"
        },
        "invested": {
          "type": "integer",
          "required": true,
          "nullable": false,
          "note": "put in so far"
        }
      }
    },
    "goals": {
      "columns": {
        "goal": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "saved": {
          "type": "integer",
          "required": true,
          "nullable": false
        },
        "target": {
          "type": "integer",
          "required": true,
          "nullable": false
        },
        "by": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "ISO date"
        }
      }
    }
  },
  "settings": []
}
