{
  "name": "dashboard",
  "version": "1.0.1",
  "description": "A live page of key numbers, a trend and recent events that an agent keeps current.",
  "objects": [
    "globe"
  ],
  "labels": {
    "title.overview": "Dashboard"
  },
  "titleFromName": "title.overview",
  "tables": {
    "metrics": {
      "note": "One row per reading. A number on the page is the newest reading of its label; the trend is the readings over time. List sample readings of a label oldest first: they are spread over past weeks in the order given.",
      "columns": {
        "label": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "value": {
          "type": "number",
          "required": true,
          "nullable": false
        },
        "unit": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "\"₹\" shows as money, \"%\" as a percent, anything else as a number"
        }
      }
    },
    "events": {
      "columns": {
        "title": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "at": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "ISO date or date-time"
        },
        "kind": {
          "type": "string",
          "required": false,
          "nullable": true,
          "default": "Note",
          "enum": [
            "Sale",
            "Alert",
            "Milestone",
            "Note"
          ],
          "note": "Sale | Alert | Milestone | Note"
        }
      }
    }
  },
  "settings": []
}
