{
  "name": "LinkedIn",
  "slug": "linkedin",
  "icon": "icon.svg",
  "description": "Read notifications, browse feed, publish posts, send messages, check messages, monitor post comments, and reply to comments on LinkedIn",
  "version": "1.2.2",
  "author": "flock",
  "category": "integration",
  "tags": [
    "social",
    "linkedin",
    "professional"
  ],
  "minFlockVersion": "0.10.3",
  "tier": "installable",
  "requires": [
    {
      "type": "browser_session",
      "service": "linkedin",
      "accessLevel": "read",
      "description": "Browse LinkedIn feed and messages",
      "recommended": true,
      "rationale": "LinkedIn has no public API for individuals \u2014 a saved browser session is the only supported way to read your feed and messages."
    }
  ],
  "id": "linkedin",
  "security": {
    "allowedFunctions": [
      "linkedin"
    ],
    "functionEffects": {
      "notifications": "read",
      "feed": "read",
      "profile": "read",
      "messages": "read",
      "search": "read",
      "comments": "read",
      "post": "irreversible",
      "draft-post": "draft",
      "send-message": "irreversible",
      "reply-comment": "irreversible"
    }
  }
}
