{
  "name": "Zepto",
  "slug": "zepto",
  "icon": "icon.svg",
  "description": "Search products, manage cart, and place grocery orders on Zepto",
  "version": "1.3.1",
  "author": "flock",
  "category": "integration",
  "tags": [
    "grocery",
    "delivery",
    "shopping",
    "zepto"
  ],
  "minFlockVersion": "0.18.1",
  "tier": "installable",
  "requires": [
    {
      "type": "browser_session",
      "service": "zepto",
      "description": "Log in to Zepto via the dashboard browser session to access grocery delivery",
      "recommended": true,
      "rationale": "Zepto has no public API \u2014 a saved browser session is how the agent shops on your behalf."
    }
  ],
  "auth": {
    "type": "browser_session",
    "browser": {
      "sessionName": "zepto",
      "setup_instructions": "Log in to your Zepto account via the dashboard. Ensure your delivery address is set to the correct location before connecting."
    }
  },
  "enabled": true,
  "hasScripts": true,
  "id": "zepto",
  "networkAccess": true,
  "paramSchema": [],
  "rateLimits": {
    "search-products": {
      "limit": 60,
      "abuseThreshold": 300
    },
    "add-to-cart": {
      "limit": 30,
      "abuseThreshold": 150
    },
    "view-cart": {
      "limit": 60,
      "abuseThreshold": 300
    },
    "remove-from-cart": {
      "limit": 30,
      "abuseThreshold": 150
    },
    "track-order": {
      "limit": 60,
      "abuseThreshold": 300
    },
    "view-order-history": {
      "limit": 30,
      "abuseThreshold": 150
    },
    "checkout": {
      "abuseThreshold": 30,
      "limit": 10
    },
    "keep-alive": {
      "abuseThreshold": 600,
      "limit": 120
    }
  },
  "functions": {
    "checkout": {
      "timeoutMs": 90000,
      "reason": "review opens the cart (up to two browser steps); pay clicks through to the payment page and its UPI option with payment capture on, waiting up to 20s for the payment page. Killed at 30s, the person is left with a half-opened payment page."
    }
  },
  "requiresAny": false,
  "requiresInstance": true,
  "scope": "per-agent",
  "secretRefs": [],
  "security": {
    "allowedFunctions": [
      "search-products",
      "add-to-cart",
      "view-cart",
      "remove-from-cart",
      "track-order",
      "view-order-history",
      "checkout",
      "keep-alive"
    ],
    "trustLevel": "third-party",
    "networkEndpoints": [
      {
        "hostname": "www.zepto.com",
        "purpose": "Zepto grocery delivery",
        "methods": [
          "GET",
          "POST"
        ]
      }
    ]
  }
}
