{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Rows a request may bring for the tracker template: { table: [row] }. Generated by scripts/gen-schemas.ts; do not edit.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$key": {
            "type": "string",
            "minLength": 1,
            "description": "This row's name within the request, for $ref"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "New",
              "In progress",
              "Waiting",
              "Done"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "due": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Low",
              "Normal",
              "High",
              null
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "$key",
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
