{
  "name": "tracker",
  "version": "1.1.2",
  "description": "Rows with a status: vendors, repairs, collections, anything to follow up. Not for hiring (use pipeline).",
  "objects": [
    "clipboard"
  ],
  "labels": {
    "nav.list": "All",
    "title.list": "Tracker"
  },
  "titleFromName": "title.list",
  "tables": {
    "items": {
      "columns": {
        "title": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "status": {
          "type": "string",
          "required": false,
          "nullable": false,
          "default": "New",
          "enum": [
            "New",
            "In progress",
            "Waiting",
            "Done"
          ],
          "note": "New | In progress | Waiting | Done"
        },
        "owner": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "due": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "ISO date"
        },
        "priority": {
          "type": "string",
          "required": false,
          "nullable": true,
          "default": "Normal",
          "enum": [
            "Low",
            "Normal",
            "High"
          ],
          "note": "Low | Normal | High"
        },
        "notes": {
          "type": "string",
          "required": false,
          "nullable": true
        }
      }
    }
  },
  "settings": []
}
