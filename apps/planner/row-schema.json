{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Rows a request may bring for the planner app: { table: [row] }. Generated by scripts/gen-schemas.ts; do not edit.",
  "type": "object",
  "properties": {
    "meals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$key": {
            "type": "string",
            "minLength": 1,
            "description": "This row's name within the request, for $ref"
          },
          "date": {
            "type": "string"
          },
          "slot": {
            "type": "string",
            "enum": [
              "Breakfast",
              "Lunch",
              "Dinner"
            ]
          },
          "dish": {
            "type": "string"
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "null"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "$ref": {
                    "type": "string",
                    "pattern": "^recipes/.+"
                  }
                },
                "required": [
                  "$ref"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "$key",
          "date",
          "slot",
          "dish"
        ],
        "additionalProperties": false
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$key": {
            "type": "string",
            "minLength": 1,
            "description": "This row's name within the request, for $ref"
          },
          "name": {
            "type": "string"
          },
          "ingredients": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "$key",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "groceries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$key": {
            "type": "string",
            "minLength": 1,
            "description": "This row's name within the request, for $ref"
          },
          "item": {
            "type": "string"
          },
          "aisle": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Vegetables",
              "Dairy",
              "Staples",
              "Spices",
              "Other",
              null
            ]
          },
          "done": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "for_dish": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "$key",
          "item"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
