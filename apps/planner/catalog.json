{
  "name": "planner",
  "version": "3.0.0",
  "description": "The family's meals for the week, day by day, with the groceries for them ordered on the family's grocery app, the everyday items and the family's recipe book; not for school runs, chores or appointments.",
  "objects": [
    "grocery-bag"
  ],
  "labels": {
    "nav.week": "Week",
    "nav.shopping": "Shopping",
    "nav.recipes": "Recipes",
    "nav.family": "Family",
    "title.week": "This week's meals",
    "title.shopping": "Shopping",
    "title.recipes": "Recipes",
    "title.family": "Family"
  },
  "tables": {
    "people": {
      "note": "Who eats at home.",
      "columns": {
        "name": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "relationship": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "group": {
          "type": "string",
          "required": false,
          "nullable": true,
          "enum": [
            "child",
            "adult",
            "elder"
          ],
          "note": "child | adult | elder (constants.ts GROUPS)"
        },
        "portions": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "in the family's words"
        },
        "diet": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "allergies": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "dislikes": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "targets": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "note": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "active": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 1
        }
      }
    },
    "house": {
      "note": "The household itself: one row.",
      "columns": {
        "rules": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON [{ kind: veg | egg | fasting | no_onion_garlic | other, days: string[], note? }]"
        },
        "cook_name": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "cook_days": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON weekday[]"
        },
        "cook_arrival": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "\"HH:MM\""
        },
        "cook_makes_well": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "cook_note": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "extra_slots": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON [{ name, days?: string[], for?: string[] }]"
        },
        "order_in": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON [{ day, slot, note? }]"
        },
        "notes": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "profile_to_structure": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "the 2.0 household.profile, waiting to be turned into rows"
        },
        "intro_sent_at": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "dinner_check_time": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "\"HH:MM\": when the dinner check-in really runs, written by that routine"
        },
        "tomorrow_check_time": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "\"HH:MM\": the same for the tomorrow check-in"
        }
      }
    },
    "plan_meals": {
      "note": "One meal of the plan: a date and a slot, made of dishes.",
      "columns": {
        "date": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "slot": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "Breakfast | Lunch | Dinner, or one of house.extra_slots"
        },
        "ordered_in": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 0,
          "note": "1: food is ordered in, so no dishes and no ingredients"
        },
        "note": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "status": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "constants.ts ORDER_STATUSES"
        }
      }
    },
    "dishes": {
      "columns": {
        "meal_id": {
          "type": "string",
          "required": true,
          "nullable": false,
          "references": "plan_meals"
        },
        "position": {
          "type": "integer",
          "required": false,
          "nullable": true
        },
        "name": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "for_people": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON string[]"
        },
        "portion_note": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "recipe_id": {
          "type": "string",
          "required": false,
          "nullable": true,
          "references": "saved_recipes"
        },
        "video_url": {
          "type": "string",
          "required": false,
          "nullable": true
        }
      }
    },
    "dish_items": {
      "note": "What a dish needs bought, in the amount for this family.",
      "columns": {
        "dish_id": {
          "type": "string",
          "required": true,
          "nullable": false,
          "references": "dishes"
        },
        "item": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "normalised"
        },
        "amount": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "unit": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "keeps": {
          "type": "string",
          "required": false,
          "nullable": true,
          "default": "fresh",
          "enum": [
            "fresh",
            "long"
          ],
          "note": "fresh | long (constants.ts KEEPS)"
        }
      }
    },
    "regulars": {
      "note": "Everyday items no dish asks for (milk, bread, fruit).",
      "columns": {
        "item": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "normalised"
        },
        "amount": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "unit": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "every": {
          "type": "string",
          "required": true,
          "nullable": false,
          "enum": [
            "day",
            "week",
            "weekdays"
          ],
          "note": "day | week | weekdays (constants.ts EVERY)"
        },
        "times_per_week": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "note": "for every = week"
        },
        "weekdays": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON weekday[], for every = weekdays"
        },
        "for_whom": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "keeps": {
          "type": "string",
          "required": false,
          "nullable": true,
          "default": "fresh",
          "enum": [
            "fresh",
            "long"
          ],
          "note": "fresh | long (constants.ts KEEPS)"
        },
        "active": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 1
        },
        "paused_until": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "a date: not needed up to and including it"
        }
      }
    },
    "orders": {
      "note": "One grocery order: what is bought for the days it covers.",
      "columns": {
        "place_at": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "\"YYYY-MM-DDTHH:MM\""
        },
        "covers_from": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "covers_to": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "week_start": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "app": {
          "type": "string",
          "required": true,
          "nullable": false,
          "enum": [
            "zepto",
            "swiggy-instamart",
            "zomato-blinkit",
            "bigbasket"
          ],
          "note": "constants.ts GROCERY_APPS"
        },
        "status": {
          "type": "string",
          "required": true,
          "nullable": false,
          "enum": [
            "scheduled",
            "placed",
            "paid",
            "not_paid",
            "cancelled"
          ],
          "note": "constants.ts ORDER_STATUSES"
        },
        "total": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "placed_at": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "paid_at": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "app_order_ref": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "wake_sent_at": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "the agent was woken to place it"
        },
        "skipped_items": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON string[]: items the family said they have"
        },
        "note": {
          "type": "string",
          "required": false,
          "nullable": true
        }
      }
    },
    "order_lines": {
      "columns": {
        "order_id": {
          "type": "string",
          "required": true,
          "nullable": false,
          "references": "orders"
        },
        "item": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "normalised"
        },
        "amount": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "unit": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "qty": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "note": "packs"
        },
        "qty_checked": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 1,
          "note": "0: the pack could not be worked out, the agent sets qty when placing"
        },
        "product_id": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "name_on_app": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "pack": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "price": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "image": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "source": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "dish | regular | added"
        },
        "sources": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON [{ kind, id, label }]"
        }
      }
    },
    "products": {
      "note": "The product the family buys for an item on a grocery app, remembered once the agent has picked it.",
      "columns": {
        "item": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "normalised"
        },
        "app": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "constants.ts GROCERY_APPS"
        },
        "product_id": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "name_on_app": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "pack": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "pack_amount": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "pack_unit": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "price": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "image": {
          "type": "string",
          "required": false,
          "nullable": true
        }
      }
    },
    "saved_recipes": {
      "columns": {
        "name": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "links": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON string[]"
        },
        "source": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "dish | regular | added"
        },
        "thumbnail": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "notes": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "ingredients": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON [{ item, amount, unit }]"
        },
        "tags": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON string[]"
        },
        "for_people": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON string[]"
        }
      }
    }
  },
  "settings": [
    {
      "key": "grocery_app",
      "type": "string",
      "default": "zepto",
      "label": "The grocery app orders go to",
      "scope": "owner",
      "constraint": "grocery_app must be one of: zepto, swiggy-instamart, zomato-blinkit, bigbasket"
    }
  ]
}
