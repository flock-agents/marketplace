{
  "name": "planner",
  "version": "1.1.2",
  "description": "The family's meals for the week, day by day (Breakfast, Lunch and Dinner), with a shared grocery list and the family's recipe book; not for school runs, chores or appointments.",
  "objects": [
    "grocery-bag"
  ],
  "labels": {
    "nav.week": "Week",
    "nav.groceries": "Groceries",
    "nav.recipes": "Recipes",
    "title.week": "This week's meals",
    "title.groceries": "Groceries",
    "title.recipes": "Recipes"
  },
  "tables": {
    "meals": {
      "note": "One row per dish; the rows on one date and slot are that meal (Monday lunch: Rice, Sambar, Bhindi fry as three rows)",
      "columns": {
        "date": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "ISO date"
        },
        "slot": {
          "type": "string",
          "required": true,
          "nullable": false,
          "enum": [
            "Breakfast",
            "Lunch",
            "Dinner"
          ],
          "note": "Breakfast | Lunch | Dinner"
        },
        "dish": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "one dish, never a list: \"Sambar\", not \"Rice, sambar\""
        },
        "recipe_id": {
          "type": "string",
          "required": false,
          "nullable": true,
          "references": "recipes"
        }
      }
    },
    "recipes": {
      "columns": {
        "name": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "ingredients": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "one per line: \"Rajma, 1 cup\""
        },
        "method": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "how the family makes it"
        },
        "notes": {
          "type": "string",
          "required": false,
          "nullable": true
        }
      }
    },
    "groceries": {
      "columns": {
        "item": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "aisle": {
          "type": "string",
          "required": false,
          "nullable": true,
          "default": "Other",
          "enum": [
            "Vegetables",
            "Dairy",
            "Staples",
            "Spices",
            "Other"
          ],
          "note": "Vegetables | Dairy | Staples | Spices | Other"
        },
        "done": {
          "type": "boolean",
          "required": false,
          "nullable": true,
          "default": false,
          "note": "bought"
        },
        "for_dish": {
          "type": "string",
          "required": false,
          "nullable": true
        }
      }
    }
  },
  "settings": []
}
