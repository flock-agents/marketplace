{
  "name": "planner",
  "version": "3.1.0",
  "description": "The family's meals for the week on the days they cook, a running-out guess for the things they buy from their order history, and a reminder each afternoon and evening with one cart per shopping app that is ordered only when they say yes; not for school runs, chores or appointments.",
  "objects": [
    "grocery-bag"
  ],
  "labels": {
    "nav.week": "Week",
    "nav.shopping": "Shopping",
    "nav.pantry": "Pantry",
    "nav.recipes": "Recipes",
    "nav.family": "Family",
    "nav.settings": "Settings",
    "title.week": "This week's meals",
    "title.shopping": "Shopping",
    "title.pantry": "Pantry",
    "title.recipes": "Recipes",
    "title.family": "Family",
    "title.settings": "Settings"
  },
  "tables": {
    "people": {
      "note": "Who eats at home.",
      "columns": {
        "name": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "relationship": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "group": {
          "type": "string",
          "required": false,
          "nullable": true,
          "enum": [
            "child",
            "adult",
            "elder"
          ],
          "note": "constants.ts ITEM_GROUPS"
        },
        "portions": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "in the family's words"
        },
        "diet": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "allergies": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "dislikes": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "targets": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "note": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "active": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 1
        }
      }
    },
    "house": {
      "note": "The household itself: one row.",
      "columns": {
        "rules": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON [{ kind: veg | egg | no_eggs | no_meat | fasting | no_onion_garlic | other, days: string[] (empty: every day), note? }]"
        },
        "cook_name": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "cook_days": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON weekday[]"
        },
        "cook_arrival": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "\"HH:MM\", or for a cook who comes more than once JSON [{ at: \"HH:MM\", meals?: string[] }]"
        },
        "cook_makes_well": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "cook_wont_make": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "what the cook does not make well or will not make"
        },
        "cook_time_limit": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "the cook's time, in the family's words (\"leaves early: a dish or two in the morning\")"
        },
        "cook_new_recipes": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "open (new recipes from reels and the internet) | set_menu (familiar dishes)"
        },
        "cook_note": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "extra_slots": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON [{ name, days?: string[], for?: string[] }]"
        },
        "order_in": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON [{ day, slot, note? }]"
        },
        "notes": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "profile_to_structure": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "the 2.0 household.profile, waiting to be turned into rows"
        },
        "intro_sent_at": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "afternoon_time": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "\"HH:MM\": when the afternoon reminder really runs, written by that routine"
        },
        "evening_time": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "\"HH:MM\": the same for the evening reminder"
        },
        "plan_time": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "\"HH:MM\": the same for the weekly plan"
        },
        "cooking_days": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON weekday[]; Mon to Sat until set"
        },
        "connected_apps": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON GroceryApp[]: the shopping apps the family has signed in to (the main app only once it is)"
        },
        "history_synced": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON { [app or \"app:account\"]: { [reader]: \"YYYY-MM-DD\" } }: how far each reader (a person's agent) read each app's order history, per shop account when named; a plain date is from before readers were kept apart"
        },
        "regulars_moved_at": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "when the old everyday items (the retired regulars table's rows) became item cycles"
        },
        "asks_confirmed": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 0
        },
        "asks_still_have": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 0
        },
        "sync_session_id": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "the session the last sync-cart ask started: the next one reuses it"
        }
      }
    },
    "plan_meals": {
      "note": "One meal of the plan: a date and a slot, made of dishes.",
      "columns": {
        "date": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "slot": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "Breakfast | Lunch | Dinner, or one of house.extra_slots"
        },
        "ordered_in": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 0,
          "note": "1: food is ordered in, so no dishes and no ingredients"
        },
        "note": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "status": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "constants.ts ORDER_STATUSES"
        }
      }
    },
    "dishes": {
      "columns": {
        "meal_id": {
          "type": "string",
          "required": true,
          "nullable": false,
          "references": "plan_meals"
        },
        "position": {
          "type": "integer",
          "required": false,
          "nullable": true
        },
        "name": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "for_people": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON string[]"
        },
        "portion_note": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "recipe_id": {
          "type": "string",
          "required": false,
          "nullable": true,
          "references": "saved_recipes"
        },
        "video_url": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "a YouTube video, an Instagram reel or any page: the link only"
        }
      }
    },
    "dish_items": {
      "note": "What a dish needs bought, in the amount for this family.",
      "columns": {
        "dish_id": {
          "type": "string",
          "required": true,
          "nullable": false,
          "references": "dishes"
        },
        "item": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "normalised"
        },
        "amount": {
          "type": "number",
          "required": false,
          "nullable": true,
          "note": "base unit"
        },
        "unit": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "g | ml | pc"
        }
      }
    },
    "regulars": {
      "note": "Retired: everyday items are now each item's own cycle (items.stated_amount, items.stated_days). Rows here are moved to items once (regulars.ts) and never read again; write none.",
      "columns": {
        "item": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "normalised"
        },
        "amount": {
          "type": "number",
          "required": false,
          "nullable": true,
          "note": "base unit"
        },
        "unit": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "g | ml | pc"
        },
        "every": {
          "type": "string",
          "required": true,
          "nullable": false,
          "enum": [
            "day",
            "week",
            "weekdays"
          ],
          "note": "day | week | weekdays (constants.ts EVERY)"
        },
        "times_per_week": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "note": "for every = week"
        },
        "weekdays": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON weekday[], for every = weekdays"
        },
        "for_whom": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "active": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 1
        },
        "paused_until": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "a date: not needed up to and including it"
        }
      }
    },
    "items": {
      "note": "What the family buys, one row per item: its group, the cycle the family stated (if any), what a purchase usually is and when it runs out (the cached estimate, from the whole house's purchases, else from the stated cycle).",
      "columns": {
        "item": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "normalised"
        },
        "name": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "group": {
          "type": "string",
          "required": false,
          "nullable": true,
          "enum": [
            "daily",
            "few_days",
            "monthly"
          ],
          "note": "constants.ts ITEM_GROUPS"
        },
        "unit": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "g | ml | pc"
        },
        "follows_plan": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 0
        },
        "subscription": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "the family's words, or null"
        },
        "dont_ask": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 0
        },
        "snoozed_until": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "asks_unanswered": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 0
        },
        "last_ask_key": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "misses_in_row": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 0
        },
        "wait_factor": {
          "type": "number",
          "required": false,
          "nullable": true,
          "default": 1
        },
        "stated_amount": {
          "type": "number",
          "required": false,
          "nullable": true,
          "note": "what the family said they buy each time, in `unit` (\"1 litre\": 1000)"
        },
        "stated_days": {
          "type": "number",
          "required": false,
          "nullable": true,
          "note": "and how often, in days (\"every day\": 1; \"once a week\": 7); used until the purchases show a cycle"
        },
        "usual_amount": {
          "type": "number",
          "required": false,
          "nullable": true,
          "note": "the cached derivation"
        },
        "lasts_days": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "product": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "app": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "constants.ts SHOP_APPS"
        },
        "last_bought": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "anchor_amount": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "run_out": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "confident": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 0
        },
        "image": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "the product's picture from the shopping app (an order's item, else the first cart line that had one); never made up"
        }
      }
    },
    "item_events": {
      "note": "What happened to an item: a purchase, an answer to a stock question, a question asked or one that went unanswered.",
      "columns": {
        "item_id": {
          "type": "string",
          "required": true,
          "nullable": false,
          "references": "items"
        },
        "date": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "kind": {
          "type": "string",
          "required": true,
          "nullable": false,
          "enum": [
            "purchase",
            "answer",
            "ask",
            "unanswered"
          ],
          "note": "constants.ts EVENT_KINDS"
        },
        "tag": {
          "type": "string",
          "required": false,
          "nullable": true,
          "enum": [
            "counted",
            "early_buy",
            "your_answer",
            "one_off",
            "not_counted"
          ],
          "note": "constants.ts EVENT_TAGS"
        },
        "app": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "constants.ts SHOP_APPS"
        },
        "product": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "product_id": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "amount": {
          "type": "number",
          "required": false,
          "nullable": true,
          "note": "base unit"
        },
        "count": {
          "type": "integer",
          "required": false,
          "nullable": true
        },
        "price": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "days": {
          "type": "number",
          "required": false,
          "nullable": true,
          "note": "an answer's \"enough for N days\""
        },
        "cycle_days": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "order_ref": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "order_id": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "account": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "the shop account an imported purchase was bought on, when named"
        },
        "note": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "void": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "default": 0
        }
      }
    },
    "orders": {
      "note": "One cart on a shopping app: the open one is being filled; the rest follow the order through ordering, placed and paid.",
      "columns": {
        "app": {
          "type": "string",
          "required": true,
          "nullable": false,
          "enum": [
            "zepto",
            "swiggy-instamart",
            "zomato-blinkit",
            "bigbasket",
            "amazon"
          ],
          "note": "constants.ts SHOP_APPS"
        },
        "status": {
          "type": "string",
          "required": true,
          "nullable": false,
          "enum": [
            "open",
            "ordering",
            "placed",
            "paid",
            "not_paid",
            "cancelled"
          ],
          "note": "constants.ts ORDER_STATUSES"
        },
        "total": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "delivery_gap": {
          "type": "number",
          "required": false,
          "nullable": true,
          "note": "rupees short of free delivery"
        },
        "synced_at": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "sync_state": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "in_step | pending | building_at_order"
        },
        "sync_asked_at": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "outside_lines": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON [{ name, qty }]: already in the cart on the app"
        },
        "ordering_at": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "reminder_key": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "\"<date>:<which>\": the reminder that ordered it without asking"
        },
        "placed_at": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "paid_at": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "app_order_ref": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "unpaid_notice": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "pending | sent"
        },
        "note": {
          "type": "string",
          "required": false,
          "nullable": true
        }
      }
    },
    "order_lines": {
      "columns": {
        "order_id": {
          "type": "string",
          "required": true,
          "nullable": false,
          "references": "orders"
        },
        "item_id": {
          "type": "string",
          "required": false,
          "nullable": true,
          "references": "items"
        },
        "item": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "normalised"
        },
        "qty": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "note": "packs; 0 = shown, not ordered"
        },
        "product_id": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "name_on_app": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "pack": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "price": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "image": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "the product's picture from the shopping app (an order's item, else the first cart line that had one); never made up"
        },
        "source": {
          "type": "string",
          "required": true,
          "nullable": false,
          "enum": [
            "everyday",
            "meal",
            "low",
            "added",
            "returned"
          ],
          "note": "constants.ts LINE_SOURCES"
        },
        "for_note": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "the line under the name: \"Tue lunch, you said it's missing\""
        },
        "for_date": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "rolled_from": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "the unpaid order this line moved here from"
        }
      }
    },
    "products": {
      "note": "The product the family buys for an item on a grocery app, remembered once the agent has picked it.",
      "columns": {
        "item": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "normalised"
        },
        "app": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "constants.ts SHOP_APPS"
        },
        "product_id": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "name_on_app": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "pack": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "pack_amount": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "pack_unit": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "price": {
          "type": "number",
          "required": false,
          "nullable": true
        },
        "image": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "the product's picture from the shopping app (an order's item, else the first cart line that had one); never made up"
        }
      }
    },
    "saved_recipes": {
      "columns": {
        "name": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "links": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON string[]"
        },
        "source": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "constants.ts LINE_SOURCES"
        },
        "thumbnail": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "notes": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "ingredients": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON [{ item, amount, unit }]"
        },
        "tags": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON string[]"
        },
        "for_people": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "JSON string[]"
        }
      }
    },
    "dish_book": {
