{
  "name": "Invoices",
  "usage": "template",
  "icon": "icon.svg",
  "description": "Bills your own customers with GST (you are the seller), tracks who has paid you, and lets an agent chase what's overdue; not for bills you pay.",
  "version": "1.1.2",
  "minFlockVersion": "0.15.0",
  "type": "fullstack",
  "access": "private",
  "spa": true,
  "apiPrefix": "/api",
  "buildCommand": "bun run app:build",
  "buildDir": "dist",
  "deployDir": ".flock-out",
  "processConfig": {
    "command": "bun",
    "args": [
      "server/index.js"
    ],
    "healthCheckPath": "/api/health"
  },
  "config": {
    "requires": {
      "agent": {
        "required": true
      }
    }
  },
  "assemble": true,
  "pages": [
    "invoices",
    "invoice",
    "customers"
  ],
  "tables": [
    "customers",
    "invoices",
    "invoice_lines",
    "payments"
  ],
  "objects": [
    "receipt",
    "handshake"
  ],
  "nav": "auto",
  "chat": "side",
  "settings": [
    {
      "key": "business.name",
      "type": "string",
      "default": "",
      "scope": "owner",
      "label": "Your business name, printed at the top of every invoice (required before an invoice can be issued)",
      "requiredWhen": {
        "table": "invoices",
        "column": "status",
        "in": [
          "sent",
          "paid",
          "overdue",
          "void"
        ],
        "rows": "an issued invoice"
      }
    },
    {
      "key": "business.gstin",
      "type": "string",
      "default": "",
      "scope": "owner",
      "label": "Your GSTIN (15 characters), or empty when the business is not registered for GST",
      "requiredWhen": {
        "table": "invoices",
        "column": "status",
        "in": [
          "sent",
          "paid",
          "overdue",
          "void"
        ],
        "rows": "an issued invoice"
      }
    },
    {
      "key": "business.address",
      "type": "string",
      "default": "",
      "scope": "owner",
      "label": "Your business address, printed under the name",
      "requiredWhen": {
        "table": "invoices",
        "column": "status",
        "in": [
          "sent",
          "paid",
          "overdue",
          "void"
        ],
        "rows": "an issued invoice"
      }
    },
    {
      "key": "business.email",
      "type": "string",
      "default": "",
      "scope": "owner",
      "label": "The email address printed on invoices",
      "requiredWhen": {
        "table": "invoices",
        "column": "status",
        "in": [
          "sent",
          "paid",
          "overdue",
          "void"
        ],
        "rows": "an issued invoice"
      }
    },
    {
      "key": "business.pay",
      "type": "string",
      "default": "",
      "scope": "owner",
      "label": "Where customers pay you (UPI id, bank account and IFSC), printed at the foot of every invoice",
      "requiredWhen": {
        "table": "invoices",
        "column": "status",
        "in": [
          "sent",
          "paid",
          "overdue",
          "void"
        ],
        "rows": "an issued invoice"
      }
    },
    {
      "key": "seller_state",
      "type": "string",
      "default": "29",
      "scope": "owner",
      "label": "Your two-digit GST state code (29 = Karnataka): a customer with a GSTIN from another state is billed IGST",
      "requiredWhen": {
        "table": "invoices",
        "column": "status",
        "in": [
          "sent",
          "paid",
          "overdue",
          "void"
        ],
        "rows": "an issued invoice"
      }
    },
    {
      "key": "number_prefix",
      "type": "string",
      "default": "INV",
      "scope": "owner",
      "label": "The start of new invoice numbers: 1 to 6 letters or digits, \"/\" allowed after the first (INV gives INV-2026-0042); issued numbers never change"
    }
  ],
  "labels": {
    "noun.one": "customer",
    "noun.many": "customers",
    "nav.invoices": "Invoices",
    "nav.customers": "Customers",
    "title.invoices": "Invoices",
    "title.customers": "Customers"
  },
  "useCases": {
    "for": [
      "Billing your own customers with GST invoices and line items",
      "Seeing who has paid, what is outstanding and what is overdue",
      "Recording payments against invoices by UPI, bank, cash or card",
      "Letting an agent draft polite reminders for overdue invoices",
      "The customer list of a small business"
    ],
    "notFor": [
      "Bills you pay to others or household spending (use money)",
      "GST filing, e-invoices (IRN / QR) or e-way bills",
      "Quotes and deals before they are won (use pipeline)"
    ]
  }
}
