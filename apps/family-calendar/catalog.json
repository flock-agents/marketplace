{
  "name": "family-calendar",
  "version": "3.0.0",
  "description": "Family events, schedules, and reminders at a glance",
  "objects": [
    "calendar"
  ],
  "labels": {
    "nav.week": "Week",
    "nav.events": "Events",
    "title.week": "This week",
    "title.events": "Upcoming events"
  },
  "tables": {
    "members": {
      "note": "The people in the family. An event names one by `name` in its `who`.",
      "columns": {
        "name": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "colour": {
          "type": "string",
          "required": false,
          "nullable": false,
          "default": "accent",
          "note": "accent | info | success | warning | danger (a theme tone)"
        },
        "emoji": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "one emoji shown before the name"
        }
      }
    },
    "events": {
      "note": "One row per event. One that happens every week (football every Tuesday) is one row with repeat weekly.",
      "columns": {
        "title": {
          "type": "string",
          "required": true,
          "nullable": false
        },
        "date": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "ISO date; for a repeating event, the first day it happens"
        },
        "repeat": {
          "type": "string",
          "required": false,
          "nullable": false,
          "default": "none",
          "note": "none | daily | weekly | monthly | yearly"
        },
        "start_time": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "\"16:30\", 24-hour; empty for an all-day event"
        },
        "end_time": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "\"17:30\", 24-hour"
        },
        "who": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "a member's name, or empty for everyone"
        },
        "location": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "notes": {
          "type": "string",
          "required": false,
          "nullable": true
        },
        "reminder_minutes": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "note": "how long before the start to remind, if at all"
        },
        "kind": {
          "type": "string",
          "required": false,
          "nullable": false,
          "default": "event",
          "note": "event | deadline (a day something is due by)"
        },
        "status": {
          "type": "string",
          "required": false,
          "nullable": false,
          "default": "active",
          "note": "active | cancelled (a cancelled event stays, struck through)"
        },
        "added_by": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "the member who added it; empty for an import (it shows its sources)"
        },
        "planned_at": {
          "type": "integer",
          "required": false,
          "nullable": true,
          "note": "ms: when its prep was last planned (imported events only)"
        },
        "plan_basis": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "\"YYYY-MM-DD\" or \"YYYY-MM-DDTHH:MM\": the date and time it was planned for"
        },
        "imported": {
          "type": "integer",
          "required": false,
          "nullable": false,
          "default": 0,
          "note": "1: first made by import_events (only these are planned)"
        },
        "monthly_by": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "a monthly event: empty or date (the 6th) | weekday (the 1st Sunday) | last_weekday"
        }
      }
    }
  },
  "settings": []
}
