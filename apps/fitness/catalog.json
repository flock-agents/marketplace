{
  "name": "fitness",
  "version": "1.0.1",
  "description": "Today and Yesterday against the goals in focus (exercise, diet, water, and activity and sleep from a connected tracker): the workout plan and planned meals beside what was done and eaten, tomorrow's plans, history and an exercise library.",
  "objects": [
    "globe"
  ],
  "labels": {
    "title.overview": "Fitness"
  },
  "titleFromName": "title.overview",
  "tables": {
    "metrics": {
      "note": "One row per reading. A number on the page is the newest reading of its label; the trend is the readings over time. List sample readings of a label oldest first: they are spread over past weeks in the order given.",
      "columns": {
        "label": {
          "type": "string",
          "required": true,
          "nullable": false,
          "note": "Steps | Calories burned | Distance"
        },
        "value": {
          "type": "number",
          "required": true,
          "nullable": false,
          "note": "the running total Zepp had then"
        },
        "unit": {
          "type": "string",
          "required": false,
          "nullable": true,
          "note": "\"₹\" shows as money, \"%\" as a percent, anything else as a number"
        }
      }
    },
