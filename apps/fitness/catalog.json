  "settings": [
    {
      "key": "person",
      "type": "string",
      "default": "",
      "label": "The name of the person this dashboard is for, as the coach's messages say it",
      "scope": "owner"
    },
    {
      "key": "timezone",
      "type": "string",
      "default": "",
      "label": "The person's time zone (IANA, e.g. Europe/London): their days start and end on this clock",
      "scope": "owner",
      "constraint": "must be an IANA time zone such as Europe/London or Asia/Kolkata"
    },
    {
      "key": "exercises_note",
      "type": "string",
      "default": "How each move is done",
      "label": "The line under the Exercises page title (e.g. what the moves are chosen for)",
      "scope": "owner"
    },
    {
      "key": "focus",
      "type": "json",
      "default": [
        "Workout",
        "PAI",
        "Calories in",
        "Protein",
        "Fiber",
        "Water"
      ],
      "label": "Goals shown on the Today page; every other goal stays on the History page",
      "scope": "owner",
      "constraint": "must be a list of goal labels"
    },
    {
      "key": "pace.enabled",
      "type": "boolean",
      "default": true,
      "label": "Pace check on: the hourly sync may wake the coach when the person is well behind their usual pace",
      "scope": "owner"
    },
    {
      "key": "pace.metrics",
      "type": "json",
      "default": [
        {
          "label": "Steps",
          "min_gap": 500
        },
        {
          "label": "Calories burned",
          "min_gap": 50
        }
      ],
      "label": "Numbers checked, each with the least shortfall worth a nudge in its own unit (steps, kcal, km)",
      "scope": "owner",
      "constraint": "must be a list of {label, min_gap}"
    },
    {
      "key": "pace.behind_ratio",
      "type": "number",
      "default": 0.5,
      "label": "Behind when today's number is below this share of where the person usually is by now (0.5 = under half)",
      "scope": "owner",
      "constraint": "must be between 0.05 and 0.95"
    },
    {
      "key": "pace.min_expected_share",
      "type": "number",
      "default": 0.25,
      "label": "No check until a usual day would have reached this share of its total (keeps slow mornings quiet)",
      "scope": "owner",
      "constraint": "must be between 0 and 0.9"
    },
    {
      "key": "pace.check_from",
      "type": "string",
      "default": "10:00",
      "label": "Earliest time of day a nudge can go",
      "scope": "owner",
      "constraint": "must be a time as HH:MM, 24-hour"
    },
    {
      "key": "pace.check_until",
      "type": "string",
      "default": "20:30",
      "label": "Latest time of day a nudge can go (later there is no day left to act on it)",
      "scope": "owner",
      "constraint": "must be a time as HH:MM, 24-hour"
    },
    {
      "key": "pace.routine_days",
      "type": "integer",
      "default": 21,
      "label": "Days of history that make the person's usual routine",
      "scope": "owner",
      "constraint": "must be between 3 and 60"
    },
    {
      "key": "pace.min_routine_days",
      "type": "integer",
      "default": 5,
      "label": "Usual days needed before a personal routine (or a weekday/weekend split) is trusted over the default",
      "scope": "owner",
      "constraint": "must be between 1 and 60"
    },
    {
      "key": "pace.split_weekends",
      "type": "boolean",
      "default": true,
      "label": "Compare weekdays with weekdays and weekends with weekends, once there are enough of each",
      "scope": "owner"
    },
    {
      "key": "pace.off_day_share",
      "type": "number",
      "default": 0.3,
      "label": "A past day below this share of a typical day's total (watch off, ill, travelling) is left out of the usual routine",
      "scope": "owner",
      "constraint": "must be between 0 and 0.9"
    },
    {
      "key": "pace.reference",
      "type": "string",
      "default": "usual",
      "label": "What \"on pace\" aims at: the usual day's total, or the day's goal when one is set",
      "scope": "owner",
      "constraint": "must be usual or goal"
    },
    {
      "key": "pace.max_data_age_minutes",
      "type": "integer",
      "default": 90,
      "label": "Staleness cutoff: only judge pace when today's tracker data (its newest reading, uploaded with the steps) is at most this many minutes old. Older, or none from today, is a sync gap, not the person: the cycle is skipped silently",
      "scope": "owner",
      "constraint": "must be between 15 and 240"
    },
    {
      "key": "pace.max_nudges_per_day",
      "type": "integer",
      "default": 1,
      "label": "Most coach wake-ups a day for being behind",
      "scope": "owner",
      "constraint": "must be between 0 and 6"
    },
    {
      "key": "pace.nudge_gap_hours",
      "type": "number",
      "default": 3,
      "label": "Least time between two nudges on the same day",
      "scope": "owner",
      "constraint": "must be between 0.5 and 12"
    },
    {
      "key": "pace.default_curve",
      "type": "json",
      "default": [
        [
          "06:00",
          0
        ],
        [
          "08:00",
          0.08
        ],
        [
          "10:00",
          0.2
        ],
        [
          "12:00",
          0.35
        ],
        [
          "14:00",
          0.5
        ],
        [
          "16:00",
          0.62
        ],
        [
          "18:00",
          0.75
        ],
        [
          "20:00",
          0.9
        ],
        [
          "22:00",
          1
        ]
      ],
      "label": "Share of a usual day's total reached by each time, used until the person's own hourly history is long enough",
      "scope": "owner",
      "constraint": "must be a list of at least two [\"HH:MM\", share] points"
    }
  ]
}
